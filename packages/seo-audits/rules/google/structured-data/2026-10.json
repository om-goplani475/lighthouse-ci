{
  "version": "2026-10",
  "types": {
    "Product": {
      "required": ["name", "image", "offers"],
      "nested": {
        "offers": {
          "type": "Offer",
          "required": ["price", "priceCurrency", "availability"]
        }
      },
      "conditional": []
    },
    "Article": {
      "required": ["headline", "image", "datePublished"],
      "nested": {},
      "conditional": []
    },
    "BreadcrumbList": {
      "required": ["itemListElement"],
      "nested": {
        "itemListElement": {
          "type": "ListItem",
          "required": ["position", "name", "item"]
        }
      },
      "conditional": []
    },
    "Organization": {
      "required": ["name", "url", "logo"],
      "nested": {},
      "conditional": []
    },
    "LocalBusiness": {
      "required": ["name", "address"],
      "nested": {
        "address": {
          "type": "PostalAddress",
          "required": ["streetAddress", "addressLocality"]
        }
      },
      "conditional": []
    },
    "Recipe": {
      "required": ["name", "image", "author", "recipeIngredient", "recipeInstructions"],
      "nested": {},
      "conditional": []
    },
    "Review": {
      "required": ["itemReviewed", "author", "reviewRating"],
      "nested": {
        "itemReviewed": {
          "type": "Thing",
          "required": ["name"]
        },
        "author": {
          "type": "Person",
          "required": ["name"]
        },
        "reviewRating": {
          "type": "Rating",
          "required": ["ratingValue"]
        }
      },
      "conditional": []
    },
    "Event": {
      "required": ["name", "startDate", "location"],
      "nested": {
        "location": {
          "type": "Place",
          "required": ["name", "address"]
        }
      },
      "conditional": []
    },
    "JobPosting": {
      "required": ["title", "description", "datePosted", "hiringOrganization", "jobLocation"],
      "nested": {
        "hiringOrganization": {
          "type": "Organization",
          "required": ["name"]
        },
        "jobLocation": {
          "type": "Place",
          "required": ["address"]
        }
      },
      "conditional": []
    },
    "VideoObject": {
      "required": ["name", "description", "thumbnailUrl", "uploadDate"],
      "nested": {},
      "conditional": []
    },
    "HowTo": {
      "required": ["name", "step"],
      "nested": {
        "step": {
          "type": "HowToStep",
          "required": ["text"]
        }
      },
      "conditional": []
    }
  }
}
