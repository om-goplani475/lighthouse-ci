{
  "version": "2026-10",
  "types": {
    "Product": {
      "required": ["name", "offers|review|aggregateRating"],
      "recommended": ["image"],
      "nested": {
        "offers": {
          "type": "Offer",
          "required": ["price|priceSpecification|lowPrice"],
          "recommended": ["priceCurrency", "availability"],
          "datatypes": {"price": "number", "priceCurrency": "currency"}
        }
      },
      "conditional": []
    },
    "Article": {
      "required": [],
      "recommended": ["headline", "image", "datePublished", "dateModified", "author"],
      "nested": {},
      "datatypes": {"datePublished": "date"},
      "conditional": []
    },
    "BreadcrumbList": {
      "required": ["itemListElement"],
      "nested": {
        "itemListElement": {
          "type": "ListItem",
          "required": ["position", "name"]
        }
      },
      "conditional": []
    },
    "Organization": {
      "required": [],
      "recommended": ["name", "url", "logo"],
      "nested": {},
      "conditional": []
    },
    "LocalBusiness": {
      "required": ["name", "address"],
      "nested": {
        "address": {
          "type": "PostalAddress",
          "required": [],
          "recommended": ["streetAddress", "addressLocality"]
        }
      },
      "conditional": []
    },
    "Recipe": {
      "required": ["name", "image"],
      "recommended": ["author", "recipeIngredient", "recipeInstructions"],
      "nested": {},
      "conditional": []
    },
    "Review": {
      "required": ["itemReviewed", "author", "reviewRating"],
      "recommended": ["datePublished"],
      "nested": {
        "itemReviewed": {
          "type": "Thing",
          "required": ["name"]
        },
        "author": {
          "type": "Person",
          "required": ["name"]
        },
        "reviewRating": {
          "type": "Rating",
          "required": ["ratingValue"],
          "datatypes": {"ratingValue": "number"}
        }
      },
      "conditional": []
    },
    "Event": {
      "required": ["name", "startDate", "location"],
      "recommended": ["endDate", "description", "image"],
      "nested": {
        "location": {
          "type": "Place",
          "required": ["name", "address"]
        }
      },
      "datatypes": {"startDate": "date"},
      "conditional": []
    },
    "JobPosting": {
      "required": ["title", "description", "datePosted", "hiringOrganization", "jobLocation"],
      "recommended": ["validThrough", "baseSalary", "employmentType"],
      "nested": {
        "hiringOrganization": {
          "type": "Organization",
          "required": ["name"]
        },
        "jobLocation": {
          "type": "Place",
          "required": ["address"]
        }
      },
      "datatypes": {"datePosted": "date"},
      "conditional": []
    },
    "VideoObject": {
      "required": ["name", "thumbnailUrl", "uploadDate"],
      "recommended": ["description", "contentUrl", "embedUrl"],
      "nested": {},
      "datatypes": {"uploadDate": "date"},
      "conditional": []
    },
    "HowTo": {
      "required": ["name", "step"],
      "nested": {
        "step": {
          "type": "HowToStep",
          "required": ["text"]
        }
      },
      "conditional": []
    },
    "FAQPage": {
      "required": ["mainEntity"],
      "nested": {
        "mainEntity": {
          "type": "Question",
          "required": ["name", "acceptedAnswer"]
        }
      },
      "conditional": []
    }
  }
}
