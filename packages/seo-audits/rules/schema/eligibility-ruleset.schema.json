{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EligibilityRuleSet",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "types"],
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "types": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["supported", "richResultFeature"],
        "properties": {
          "supported": {"type": "boolean"},
          "richResultFeature": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    }
  }
}
