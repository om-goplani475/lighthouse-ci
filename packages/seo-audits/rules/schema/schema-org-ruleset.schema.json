{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SchemaOrgRuleSet",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "universal", "types"],
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "universal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {"type": "array", "items": {"type": "string"}}
      }
    },
    "types": {"type": "object"}
  }
}
