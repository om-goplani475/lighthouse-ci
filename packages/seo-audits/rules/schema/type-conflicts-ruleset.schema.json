{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TypeConflictsRuleSet",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "singularTypes", "identityFields"],
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "singularTypes": {"type": "array", "items": {"type": "string"}},
    "identityFields": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    }
  }
}
