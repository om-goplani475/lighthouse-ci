{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GoogleRequirementsRuleSet",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "types"],
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
    "types": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["required", "nested", "conditional"],
        "properties": {
          "required": {"type": "array", "items": {"type": "string"}},
          "nested": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "required"],
              "properties": {
                "type": {"type": "string"},
                "required": {"type": "array", "items": {"type": "string"}}
              }
            }
          },
          "conditional": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["if", "then"],
              "properties": {
                "if": {"type": "object"},
                "then": {"type": "object"}
              }
            }
          }
        }
      }
    }
  }
}
